/* ГЛАВНОЕ ОКНО */
QMainWindow {
    background-color: #f5f5f7;
}

/* ВКЛАДКИ */
QTabWidget::pane {
    border: 1px solid #d2d2d7;
    background: #ffffff;
    border-radius: 10px;
}

QTabBar::tab {
    background: transparent;
    color: #6e6e73;
    padding: 14px 32px;
    margin: 0 4px;
    border: none;
    font-size: 15px;
    font-weight: 600;
    font-family: "Times New Roman", serif;
    border-bottom: 3px solid transparent;
}

QTabBar::tab:selected {
    color: #1c1c1e;
    border-bottom: 3px solid #34c759;
}

QTabBar::tab:hover:!selected {
    color: #1c1c1e;
    border-bottom: 3px solid #c7c7cc;
}

/* ЛЕЙБЛЫ */
QLabel {
    color: #1c1c1e;
    font-family: "Times New Roman", serif;
}

QLabel.card-title {
    font-size: 13px;
    font-weight: 600;
    color: #6e6e73;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    padding: 4px 0;
    border-bottom: 1px solid #e5e5ea;
}

/* Главная Панель КАРТОЧКИ */
QFrame.card {
    border-radius: 16px;
    padding: 18px 20px;
    border: 1px solid #d2d2d7;
    background-color: #ffffff;
}

/* Задачи текущие – зелёный */
QFrame#frameTodayTasks {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(52, 199, 89, 0.08),
        stop: 1 rgba(52, 199, 89, 0.02)
    );
    border-color: #34c759;
}
QFrame#frameTodayTasks:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(52, 199, 89, 0.15),
        stop: 1 rgba(52, 199, 89, 0.05)
    );
    border-color: #28a745;
    box-shadow: 0 4px 20px rgba(52, 199, 89, 0.15);
}

/* Выполнено – синий */
QFrame#frameCompletedTasks {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(0, 122, 255, 0.08),
        stop: 1 rgba(0, 122, 255, 0.02)
    );
    border-color: #007aff;
}
QFrame#frameCompletedTasks:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(0, 122, 255, 0.15),
        stop: 1 rgba(0, 122, 255, 0.05)
    );
    border-color: #0055cc;
    box-shadow: 0 4px 20px rgba(0, 122, 255, 0.15);
}

/* В ожидании – жёлтый */
QFrame#framePendingTasks {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(255, 149, 0, 0.08),
        stop: 1 rgba(255, 149, 0, 0.02)
    );
    border-color: #ff9500;
}
QFrame#framePendingTasks:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(255, 149, 0, 0.15),
        stop: 1 rgba(255, 149, 0, 0.05)
    );
    border-color: #cc7a00;
    box-shadow: 0 4px 20px rgba(255, 149, 0, 0.15);
}

/* Просрочено – красный */
QFrame#frameOverdueTasks {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(255, 59, 48, 0.08),
        stop: 1 rgba(255, 59, 48, 0.02)
    );
    border-color: #ff3b30;
}
QFrame#frameOverdueTasks:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(255, 59, 48, 0.15),
        stop: 1 rgba(255, 59, 48, 0.05)
    );
    border-color: #cc2d24;
    box-shadow: 0 4px 20px rgba(255, 59, 48, 0.15);
}

/* ЗНАЧЕНИЯ НА КАРТОЧКАХ */
QLabel#label_today_tasks_value {
    font-size: 34px;
    font-weight: bold;
    color: #34c759;
    padding: 8px 16px;
    background: rgba(52, 199, 89, 0.06);
    border-radius: 10px;
    border: 1px solid rgba(52, 199, 89, 0.15);
}

QLabel#label_completed_tasks_value {
    font-size: 28px;
    font-weight: bold;
    color: #007aff;
    padding: 8px 16px;
    background: rgba(0, 122, 255, 0.06);
    border-radius: 10px;
    border: 1px solid rgba(0, 122, 255, 0.15);
}

QLabel#label_pending_tasks_value {
    font-size: 28px;
    font-weight: bold;
    color: #ff9500;
    padding: 8px 16px;
    background: rgba(255, 149, 0, 0.06);
    border-radius: 10px;
    border: 1px solid rgba(255, 149, 0, 0.15);
}

QLabel#label_overdue_tasks_value {
    font-size: 28px;
    font-weight: bold;
    color: #ff3b30;
    padding: 8px 16px;
    background: rgba(255, 59, 48, 0.06);
    border-radius: 10px;
    border: 1px solid rgba(255, 59, 48, 0.15);
}

/* ТАБЛИЦЫ */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f9f9fb;
    color: #1c1c1e;
    gridline-color: #e5e5ea;
    selection-background-color: #34c759;
    selection-color: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 10px;
    font-family: "Times New Roman", serif;
    font-size: 13px;
    padding: 4px;
}

QHeaderView::section {
    background-color: #f5f5f7;
    color: #6e6e73;
    padding: 10px 12px;
    border: none;
    font-weight: bold;
    text-transform: uppercase;
    font-size: 12px;
    font-family: "Times New Roman", serif;
    letter-spacing: 0.5px;
}

QTableWidget::item {
    padding: 8px;
}

/* КНОПКИ зелёный */
QPushButton {
    background-color: #34c759;
    color: white;
    border: none;
    padding: 10px 28px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    font-family: "Times New Roman", serif;
}
QPushButton:hover {
    background-color: #28a745;
}
QPushButton:pressed {
    background-color: #1e7e34;
}

/* Кнопка удаления – красная */
QPushButton#btnDelete, btnDelete_2,btnDelete_3,btnDelete_4 {
    background-color: #ff3b30;
}
QPushButton#btnDelete:hover {
    background-color: #cc2d24;
}
QPushButton#btnDelete:pressed {
    background-color: #99221a;
}

/* Кнопка "Выполнить" – синяя */
QPushButton#btnCompleteTask {
    background-color: #007aff;
}
QPushButton#btnCompleteTask:hover {
    background-color: #0055cc;
}
QPushButton#btnCompleteTask:pressed {
    background-color: #003d99;
}

/* Кнопки таймера */
QPushButton#btnStartWork {
    background-color: #34c759;
}
QPushButton#btnStartWork:hover {
    background-color: #28a745;
}
QPushButton#btnStartBreak {
    background-color: #ff9500;
}
QPushButton#btnStartBreak:hover {
    background-color: #e68a00;
}
QPushButton#btnStopTimer {
    background-color: #ff3b30;
}
QPushButton#btnStopTimer:hover {
    background-color: #cc2d24;
}

/* Кнопки навигации (стрелки) – прозрачные */
QPushButton#btnIncomePrevMonth,
QPushButton#btnIncomeNextMonth,
QPushButton#btnExpensePrevMonth,
QPushButton#btnExpenseNextMonth {
    background-color: transparent;
    color: #6e6e73;
    border: none;
    padding: 8px 12px;
    font-size: 18px;
    font-weight: bold;
}
QPushButton#btnIncomePrevMonth:hover,
QPushButton#btnIncomeNextMonth:hover,
QPushButton#btnExpensePrevMonth:hover,
QPushButton#btnExpenseNextMonth:hover {
    color: #1c1c1e;
    background-color: rgba(0, 0, 0, 0.05);
    border-radius: 4px;
}

/* ПОЛЯ ВВОДА */
QLineEdit {
    background-color: #ffffff;
    color: #1c1c1e;
    border: 2px solid #d2d2d7;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 14px;
    font-family: "Times New Roman", serif;
}
QLineEdit:focus {
    border: 2px solid #34c759;
    background-color: #f5f5f7;
}
QLineEdit::placeholder {
    color: #8e8e93;
    font-style: italic;
}

/* ОПИСАНИЕ */
QTextEdit#textEditTaskDescription {
    background-color: #ffffff;
    color: #1c1c1e;
    border: 2px solid #d2d2d7;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    font-family: "Times New Roman", serif;
}

QTextEdit#textEditTaskDescription:focus {
    border: 2px solid #34c759;
    background-color: #f5f5f7;
}

QTextEdit#textEditTaskDescription {
    min-height: 150px;
    max-height: 10000px;
}

/* ОПИСАНИЕ ЗАМЕТКИ */
QTextEdit#textEditTaskNote {
    background-color: #ffffff;
    color: #1c1c1e;
    border: 2px solid #d2d2d7;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    font-family: "Times New Roman", serif;
}

QTextEdit#textEditTaskDescription:focus {
    border: 2px solid #34c759;
    background-color: #f5f5f7;
}

QTextEdit#textEditTaskDescription {
    min-height: 150px;
    max-height: 10000px;
}

QTextEdit#content_edit {
    background-color: #ffffff;
    color: #1c1c1e;
    border: 2px solid #d2d2d7;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    font-family: "Times New Roman", serif;
}

QTextEdit#textEditTaskDescription:focus {
    border: 2px solid #34c759;
    background-color: #f5f5f7;
}

QTextEdit#textEditTaskDescription {
    min-height: 150px;
    max-height: 10000px;
}

/* КОМБОБОКСЫ */
QComboBox {
    background-color: #ffffff;
    color: #1c1c1e;
    border: 2px solid #d2d2d7;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 14px;
    font-family: "Times New Roman", serif;
}
QComboBox:focus {
    border: 2px solid #34c759;
}
QComboBox::drop-down {
    border: none;
}
QComboBox::down-arrow {
    image: none;
    border: none;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1c1c1e;
    border: 2px solid #d2d2d7;
    selection-background-color: #34c759;
    selection-color: #ffffff;
}

/* МЕНЮ */
QMenuBar {
    background-color: #f5f5f7;
    color: #6e6e73;
    border-bottom: 1px solid #d2d2d7;
    font-family: "Times New Roman", serif;
    font-size: 14px;
}
QMenuBar::item:selected {
    background-color: #e5e5ea;
    color: #1c1c1e;
}
QMenu {
    background-color: #ffffff;
    color: #1c1c1e;
    border: 1px solid #d2d2d7;
    border-radius: 8px;
    font-family: "Times New Roman", serif;
}
QMenu::item:selected {
    background-color: #34c759;
    color: white;
}

/* СТАТУС-БАР */
QStatusBar {
    background-color: #f5f5f7;
    color: #6e6e73;
    font-size: 12px;
    font-family: "Times New Roman", serif;
    border-top: 1px solid #d2d2d7;
}

/* ТАЙМЕР */
QLabel#labelTimerTime {
    font-size: 48px;
    font-weight: bold;
    color: #34c759;
}

QLabel#labelTimerStatsWork {
    font-size: 14px;
    color: #34c759;
    font-weight: bold;
}

QLabel#labelTimerStatsBreak {
    font-size: 14px;

    QTableWidget#tableSessions {
    background-color: #ffffff;
    alternate-background-color: #f9f9fb;
    color: #1c1c1e;
    gridline-color: #e5e5ea;
    selection-background-color: #34c759;
    selection-color: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 10px;
}

QComboBox#comboBoxTimerTask,
QComboBox#comboBoxNoteTask {
    min-width: 150px;
}